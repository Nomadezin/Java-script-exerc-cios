//Leia um código de 1 a 7 e informe o dia da semana correspondente. Para outro código, informe invalido.

let codigo = Number(prompt("Digite um código de 1 a 7:"));

switch (codigo) {
    case 1:
        console.log("Domingo");
        break;

    case 2:
        console.log("Segunda-feira");
        break;

    case 3:
        console.log("Terça-feira");
        break;

    case 4:
        console.log("Quarta-feira");
        break;

    case 5:
        console.log("Quinta-feira");
        break;

    case 6:
        console.log("Sexta-feira");
        break;

    case 7:
        console.log("Sábado");
        break;

    default:
        console.log("Código inválido!");
}
