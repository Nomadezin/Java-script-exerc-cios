
let nomes = [];
let medias = [];

let maiorMedia = 0;
let aprovados = 0;

for (let i = 0; i < 5; i++) {
    let nome = prompt("Digite o nome do aluno:");
    nomes.push(nome);

    let nota1 = Number(prompt("Digite a primeira nota:"));
    let nota2 = Number(prompt("Digite a segunda nota:"));
    let nota3 = Number(prompt("Digite a terceira nota:"));

    let media = (nota1 + nota2 + nota3) / 3;

    medias.push(media);

    if (media >= 6) {
        aprovados++;
    }

    if (i === 0 || media > maiorMedia) {
        maiorMedia = media;
    }
}

console.log("===== RESULTADO DA TURMA =====");

for (let i = 0; i < 5; i++) {
    console.log("Aluno:", nomes[i]);
    console.log("Média:", medias[i].toFixed(2));
}

console.log("Maior média da turma:", maiorMedia.toFixed(2));
console.log("Quantidade de aprovados:", aprovados);
