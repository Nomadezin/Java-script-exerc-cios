let numero = Number(prompt("Digite um número inteiro:"));

let primo = true;

if (numero <= 1) {
    primo = false;
}

for (let i = 2; i < numero; i++) {
    if (numero % i === 0) {
        primo = false;
    }
}

if (primo) {
    console.log("É primo!");
} else {
    console.log("Não é primo!");
}
