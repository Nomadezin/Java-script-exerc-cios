//Leia uma nota de 0 a 10 e classifique: insuficiente abaixo de 5, regular de 5 a 6,9, bom de 7 a 8,9 e excelente de 9 a 10

let nota = Number(prompt("Digite uma nota de 0 a 10:"));

if (nota < 5) {
    console.log("Insuficiente");
} else if (nota < 7) {
    console.log("Regular");
} else if (nota < 9) {
    console.log("Bom");
} else if (nota <= 10) {
    console.log("Excelente");
} else {
    console.log("Nota inválida!");
}
