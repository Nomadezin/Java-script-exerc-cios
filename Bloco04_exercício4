//Leia tres lados e verifique se formam um triângulo. Se formarem, classifique como equilátero, isósceles ou escaleno.

let lado1 = Number(prompt("Digite o primeiro lado:"));
let lado2 = Number(prompt("Digite o segundo lado:"));
let lado3 = Number(prompt("Digite o terceiro lado:"));

if (lado1 < lado2 + lado3 &&
    lado2 < lado1 + lado3 &&
    lado3 < lado1 + lado2) {

    if (lado1 === lado2 && lado2 === lado3) {
        console.log("Triângulo equilátero!");

    } else if (lado1 === lado2 ||
               lado1 === lado3 ||
               lado2 === lado3) {
        console.log("Triângulo isósceles!");

    } else {
        console.log("Triângulo escaleno!");
    }

} else {
    console.log("Não formam um triângulo!");
}
