//Leia números até que seja digitado um valor negativo. Informe quantos valores não negativos foram lidos.

let contador = 0;
let numero = 0;

while (numero >= 0) {
    numero = Number(prompt("Digite um número:"));

    if (numero >= 0) {
        contador++;
    }
}

console.log("Quantidade de valores não negativos:", contador);
